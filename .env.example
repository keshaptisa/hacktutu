# ---------------------------------------------------------------------------
# ESCAPE — пример конфигурации. Скопируйте в .env и заполните.
# .env НИКОГДА не коммитится. Секреты живут только в переменных окружения.
# ---------------------------------------------------------------------------

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=local          # local | staging | production
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false             # true в проде — журнал в одну строку JSON
CORS_ORIGINS=              # пусто = фронтенд с того же origin

# --- Tutu MCP --------------------------------------------------------------
MCP_URL=https://mcp.tutu.ru/mcp
MCP_ENABLED=true
MCP_TIMEOUT_S=20
MCP_CONNECT_TIMEOUT_S=6
MCP_RETRIES=2
MCP_BACKOFF_S=0.6
MCP_MAX_PARALLEL=4
MCP_PROTOCOL_VERSION=2025-06-18
# Заголовок авторизации, если он когда-нибудь потребуется. Обычно пусто.
MCP_AUTH_HEADER=
# Ручное сопоставление возможностей и реальных инструментов MCP.
# Заполняйте, только если автоопределение ошиблось: python scripts/discover_mcp.py
# MCP_TOOL_MAP={"search_train":"...","search_hotel":"..."}
MCP_TOOL_MAP=

# --- LLM (опционально; без него приложение работает детерминированно) -------
LLM_ENABLED=false
LLM_PROVIDER=openai        # openai (любой OpenAI-совместимый) | anthropic
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_S=25
LLM_MAX_TOKENS=1600
LLM_TEMPERATURE=0.7

# --- Email -----------------------------------------------------------------
# Без этих значений письмо не падает: оно сохраняется и открывается в превью.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ESCAPE <no-reply@escape.local>
SMTP_STARTTLS=true
SMTP_TIMEOUT_S=15
EMAIL_OUTBOX_DIR=var/outbox

# --- Продукт ---------------------------------------------------------------
DEMO_MODE=false            # true — офлайн-образцы вместо живого поиска
DEFAULT_ORIGIN=Москва
ESCAPE_TTL_MINUTES=180
MAX_STORED_ESCAPES=200
